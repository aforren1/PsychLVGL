--- a/src/draw/nanovg/lv_draw_nanovg.c
+++ b/src/draw/nanovg/lv_draw_nanovg.c
@@ -139,6 +139,38 @@ int lv_nanovg_fb_get_image_handle(struct NVGLUframebuffer * fb)
     return fb->image;
 }
 
+int lv_nanovg_image_from_gl_texture(lv_draw_nanovg_unit_t * u, uint32_t texture, int32_t w, int32_t h,
+                                    int image_flags)
+{
+    LV_ASSERT_NULL(u);
+
+    /* A texture without mipmaps whose minification filter still asks for
+     * them is incomplete and samples as black. Psychtoolbox leaves the
+     * OpenGL default filter on a texture made from a matrix and sets its own
+     * filter on every draw, so switching to GL_LINEAR here is harmless.
+     * Binding through glnvg__bindTexture keeps NanoVG's binding cache right. */
+    GLNVGcontext * gl = (GLNVGcontext *)nvgInternalParams(u->vg)->userPtr;
+    GLint min_filter = GL_LINEAR;
+    glActiveTexture(GL_TEXTURE0);
+    glnvg__bindTexture(gl, texture);
+    glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, &min_filter);
+    if(min_filter != GL_LINEAR && min_filter != GL_NEAREST)
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+
+    /* NODELETE: the texture belongs to the caller, so releasing the NanoVG
+     * image must not delete the OpenGL name. */
+#if defined(NANOVG_GL2_IMPLEMENTATION)
+    int handle = nvglCreateImageFromHandleGL2(u->vg, texture, w, h, image_flags | NVG_IMAGE_NODELETE);
+#elif defined(NANOVG_GL3_IMPLEMENTATION)
+    int handle = nvglCreateImageFromHandleGL3(u->vg, texture, w, h, image_flags | NVG_IMAGE_NODELETE);
+#elif defined(NANOVG_GLES2_IMPLEMENTATION)
+    int handle = nvglCreateImageFromHandleGLES2(u->vg, texture, w, h, image_flags | NVG_IMAGE_NODELETE);
+#else
+    int handle = nvglCreateImageFromHandleGLES3(u->vg, texture, w, h, image_flags | NVG_IMAGE_NODELETE);
+#endif
+    return handle > 0 ? handle : -1;
+}
