  */
 int lv_nanovg_fb_get_image_handle(struct NVGLUframebuffer * fb);
 
+/**
+ * Wrap an existing OpenGL texture as a NanoVG image without taking ownership
+ * @param u pointer to the nanovg unit
+ * @param texture the OpenGL texture name, a `GL_TEXTURE_2D` texture
+ * @param w width of the texture in pixels
+ * @param h height of the texture in pixels
+ * @param image_flags NanoVG image flags
+ * @return the image handle, or -1 on failure
+ */
+int lv_nanovg_image_from_gl_texture(lv_draw_nanovg_unit_t * u, uint32_t texture, int32_t w, int32_t h,
+                                    int image_flags);
+
 /**
  * Initialize the blur draw unit state on the given nanovg unit
  * @param u pointer to the nanovg unit
diff --git a/src/draw/nanovg/lv_nanovg_image_cache.c b/src/draw/nanovg/lv_nanovg_image_cache.c
index 356ec6b..7704f94 100644
--- a/src/draw/nanovg/lv_nanovg_image_cache.c
+++ b/src/draw/nanovg/lv_nanovg_image_cache.c
@@ -119,6 +119,31 @@ int lv_nanovg_image_cache_get_handle(struct _lv_draw_nanovg_unit_t * u,
     LV_ASSERT_NULL(u);
     LV_ASSERT_NULL(src);
 
+    /* A descriptor that names an OpenGL texture has no pixels to decode.
+     * Wrapping the name costs no upload and no GL call, so it is done again
+     * on every draw and released at the end of the frame like an uncached
+     * image; the texture itself is never deleted here. */
+    if(lv_image_src_get_type(src) == LV_IMAGE_SRC_VARIABLE) {
+        const lv_image_dsc_t * gl_dsc = src;
+        if(gl_dsc->header.flags & LV_IMAGE_FLAGS_GL_TEXTURE) {
+            uint32_t texture = 0;
+            if(gl_dsc->data == NULL || gl_dsc->data_size < sizeof(texture)) {
+                LV_PROFILER_DRAW_END;
+                return -1;
+            }
+            lv_memcpy(&texture, gl_dsc->data, sizeof(texture));
+            int flags = image_flags | NVG_IMAGE_FLIPY;
+            if(gl_dsc->header.flags & LV_IMAGE_FLAGS_PREMULTIPLIED) flags |= NVG_IMAGE_PREMULTIPLIED;
+            int handle = lv_nanovg_image_from_gl_texture(u, texture, gl_dsc->header.w, gl_dsc->header.h, flags);
+            if(handle > 0) {
+                lv_pending_add(u->image_uncached_pending, &handle);
+                if(header) *header = gl_dsc->header;
+            }
+            LV_PROFILER_DRAW_END;
+            return handle;
+        }
+    }
+
     lv_image_decoder_args_t args;
     lv_memzero(&args, sizeof(lv_image_decoder_args_t));
 
