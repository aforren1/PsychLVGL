diff --git a/include/lvgl/draw/lv_image_dsc.h b/include/lvgl/draw/lv_image_dsc.h
index 52b196b..5bf0f3d 100644
--- a/include/lvgl/draw/lv_image_dsc.h
+++ b/include/lvgl/draw/lv_image_dsc.h
@@ -76,6 +76,15 @@ typedef enum _lvimage_flags_t {
      */
     LV_IMAGE_FLAGS_CUSTOM_DRAW      = 0x0040,
 
+    /**
+     * The image descriptor names an existing OpenGL `GL_TEXTURE_2D` texture
+     * instead of carrying pixels. `data` points to a `uint32_t` that holds the
+     * texture name, and `data_size` is `sizeof(uint32_t)`. Rows are stored
+     * bottom row first, as OpenGL does. The texture stays owned by the caller.
+     * Only the NanoVG draw unit reads this flag.
+     */
+    LV_IMAGE_FLAGS_GL_TEXTURE       = 0x0080,
+
     /**
      * Flags reserved for user, lvgl won't use these bits.
      */
diff --git a/src/draw/nanovg/lv_draw_nanovg.c b/src/draw/nanovg/lv_draw_nanovg.c
index 176d1c6..d78570c 100644
--- a/src/draw/nanovg/lv_draw_nanovg.c
+++ b/src/draw/nanovg/lv_draw_nanovg.c
@@ -139,6 +139,24 @@ int lv_nanovg_fb_get_image_handle(struct NVGLUframebuffer * fb)
     return fb->image;
 }
 
+int lv_nanovg_image_from_gl_texture(lv_draw_nanovg_unit_t * u, uint32_t texture, int32_t w, int32_t h,
+                                    int image_flags)
+{
+    LV_ASSERT_NULL(u);
+    /* NODELETE: the texture belongs to the caller, so releasing the NanoVG
+     * image must not delete the OpenGL name. */
+#if defined(NANOVG_GL2_IMPLEMENTATION)
+    int handle = nvglCreateImageFromHandleGL2(u->vg, texture, w, h, image_flags | NVG_IMAGE_NODELETE);
+#elif defined(NANOVG_GL3_IMPLEMENTATION)
+    int handle = nvglCreateImageFromHandleGL3(u->vg, texture, w, h, image_flags | NVG_IMAGE_NODELETE);
+#elif defined(NANOVG_GLES2_IMPLEMENTATION)
+    int handle = nvglCreateImageFromHandleGLES2(u->vg, texture, w, h, image_flags | NVG_IMAGE_NODELETE);
+#else
+    int handle = nvglCreateImageFromHandleGLES3(u->vg, texture, w, h, image_flags | NVG_IMAGE_NODELETE);
+#endif
+    return handle > 0 ? handle : -1;
+}
+
