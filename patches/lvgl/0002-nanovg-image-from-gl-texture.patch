+static bool is_transposed_gl_texture(const void * src)
+{
+    if(lv_image_src_get_type(src) != LV_IMAGE_SRC_VARIABLE) return false;
+    const lv_image_dsc_t * img = src;
+    const uint32_t both = LV_IMAGE_FLAGS_GL_TEXTURE | LV_IMAGE_FLAGS_GL_TEXTURE_TRANSPOSED;
+    return (img->header.flags & both) == both;
+}
