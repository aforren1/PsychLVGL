diff --git a/src/draw/nanovg/lv_nanovg_image_cache.c b/src/draw/nanovg/lv_nanovg_image_cache.c
index 356ec6b..f9ef53b 100644
--- a/src/draw/nanovg/lv_nanovg_image_cache.c
+++ b/src/draw/nanovg/lv_nanovg_image_cache.c
@@ -119,6 +119,36 @@ int lv_nanovg_image_cache_get_handle(struct _lv_draw_nanovg_unit_t * u,
     LV_ASSERT_NULL(u);
     LV_ASSERT_NULL(src);
 
+    /* A descriptor that names an OpenGL texture has no pixels to decode.
+     * Wrapping the name costs no upload and no GL call, so it is done again
+     * on every draw and released at the end of the frame like an uncached
+     * image; the texture itself is never deleted here. */
+    if(lv_image_src_get_type(src) == LV_IMAGE_SRC_VARIABLE) {
+        const lv_image_dsc_t * gl_dsc = src;
+        if(gl_dsc->header.flags & LV_IMAGE_FLAGS_GL_TEXTURE) {
+            uint32_t texture = 0;
+            if(gl_dsc->data == NULL || gl_dsc->data_size < sizeof(texture)) {
+                LV_PROFILER_DRAW_END;
+                return -1;
+            }
+            lv_memcpy(&texture, gl_dsc->data, sizeof(texture));
+            /* A transposed texture needs no flip: its texel row 0 is the
+             * left image column. lv_draw_nanovg_image swaps the axes. */
+            bool transposed = (gl_dsc->header.flags & LV_IMAGE_FLAGS_GL_TEXTURE_TRANSPOSED) != 0;
+            int flags = image_flags | (transposed ? 0 : NVG_IMAGE_FLIPY);
+            if(gl_dsc->header.flags & LV_IMAGE_FLAGS_PREMULTIPLIED) flags |= NVG_IMAGE_PREMULTIPLIED;
+            int32_t tex_w = transposed ? gl_dsc->header.h : gl_dsc->header.w;
+            int32_t tex_h = transposed ? gl_dsc->header.w : gl_dsc->header.h;
+            int handle = lv_nanovg_image_from_gl_texture(u, texture, tex_w, tex_h, flags);
+            if(handle > 0) {
+                lv_pending_add(u->image_uncached_pending, &handle);
+                if(header) *header = gl_dsc->header;
+            }
+            LV_PROFILER_DRAW_END;
+            return handle;
+        }
+    }
